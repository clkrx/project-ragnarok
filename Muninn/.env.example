# Muninn environment variables -- template
# Copy this file to .env and fill in your keys.

# OpenRouter API key -- https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: override the default model and endpoint
# OPENROUTER_MODEL=qwen/qwen3.7-max
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Serper.dev API key -- https://serper.dev/api-key
SERPER_API_KEY=your-serper-api-key-here

# Discord bot
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_ALLOWED_USER_ID=your-numeric-user-id
